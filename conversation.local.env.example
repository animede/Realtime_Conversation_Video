# conversation-up.sh のローカル設定(このファイルを conversation.local.env に
# コピーして編集する。conversation.local.env は git 管理外)。
# 未設定の項目は launcher の既定値が使われる。

# 各リポジトリの場所
#MOVIE_SERVER_DIR=$HOME/diffusers-movie-server
#RNV_DIR=$HOME/realtime-narration-video

# ポート
#GATEWAY_PORT=8630
#RNV_PORT=8782
#RCV_PORT=8791

# 外部サービス(launcher は死活確認のみ。起動・管理はしない)
#TTS_URL=http://localhost:10101
#LLM_URL=http://localhost:8000/v1
#LLM_API_KEY=

# doctor の自動判定を上書きしたいときだけ(例: ref2va-only-24gb)
#FORCE_PRESET=
